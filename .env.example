# =============================================================================
# SAORI SRE Autonomous Multi-Agent Framework - Configuration Template
# =============================================================================
# Copia este archivo como `.env` y completa los valores según tu infraestructura.
# NUNCA subas tu archivo `.env` real a repositorios públicos.

# -----------------------------------------------------------------------------
# 1. IDENTIDAD, SYSTEM PROMPT Y PERSONALIZACIÓN (CERO FILTRACIONES)
# -----------------------------------------------------------------------------
# Inyecta tu propio system prompt o directivas de persona sin tocar el código fuente.
SAORI_SYSTEM_PROMPT="IDENTIDAD Y ROL DEL ASISTENTE: Eres SAORI, un asistente y agente SRE autónomo de soporte e infraestructura. Tu objetivo es asistir a los usuarios y al equipo de administración resolviendo dudas y monitoreando el sistema. Sé concisa, educada y técnica."
STAFF_MEMBERS=jack,admin,staff,moderador

# -----------------------------------------------------------------------------
# 2. DISCORD BOT & INTERACCIONES
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_OWNER_ID=your_discord_user_id_here
DISCORD_STAFF_ROLE_IDS=123456789012345678,987654321098765432
DISCORD_STAFF_USER_IDS=123456789012345678
DISCORD_SAORI_CHAT_CHANNEL_ID=123456789012345678
DISCORD_TICKETS_CATEGORY_ID=123456789012345678
DISCORD_TICKETS_SUPPORT_CHANNEL_ID=123456789012345678

# -----------------------------------------------------------------------------
# 3. WHATSAPP BRIDGE (Baileys)
# -----------------------------------------------------------------------------
AUTH_DIR=./data/auth_info
ADMIN_WHATSAPP_NUMBER=56900000000
ADMIN_PHONE_NUMBERS=56900000000
WHATSAPP_STAFF_GROUP_JID=your_staff_group_jid@g.us
SAORI_NOTIFY_WEBHOOK_URL=http://127.0.0.1:8088/notify-ticket

# -----------------------------------------------------------------------------
# 4. TRÍADA DE AGENTES SRE (Codex, Claude, Antigravity)
# -----------------------------------------------------------------------------
# Modelos con razonamiento medio para balance entre precisión y cuota
SAORI_CODEX_MODEL=gpt-5.6-sol
SAORI_AGY_MODEL=gemini-3.8-flash-high
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SAORI_TICKETS_DIR=./tickets
STAR_HOST=star.local
STAR_MEMORY_URL=http://127.0.0.1:8077

# Endpoints locales de daemons
AI_DAEMON_URL=http://127.0.0.1:8089/chat
TTS_URL=http://127.0.0.1:8089/tts
STT_URL=http://127.0.0.1:8089/stt
IMAGE_DAEMON_URL=http://127.0.0.1:8089/image

# -----------------------------------------------------------------------------
# 5. SERVIDOR DE MINECRAFT / PANEL PTERODACTYL
# -----------------------------------------------------------------------------
MC_SERVER_DOMAIN=mc.example.com
MC_SERVER_HOST=mc.example.com
MC_SERVER_PORT=25565
MC_SERVER_BEDROCK_PORT=19132
MC_WEB_URL=https://web.example.com/
MC_STORE_URL=https://web.example.com/store
MC_GUIDE_URL=https://web.example.com/guide

# API Client de Pterodactyl (Opcional, para ejecución de comandos y lectura de logs)
PTERO_BASE_URL=https://panel.example.com/api/client/servers/your_server_id
PTERO_KEY_PATH=/path/to/.pterodactyl_key

# -----------------------------------------------------------------------------
# 6. INTEGRACIONES ADICIONALES (Música Spotify, Alertas SMTP)
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SAORI_SMTP_CONFIG_PATH=./config/smtp.json
