# ==========================================
# SAORI SRE Framework - Configuration Template
# ==========================================

# --- DISCORD BOT ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_OWNER_ID=your_discord_user_id_here
DISCORD_STAFF_ROLE_IDS=123456789012345678,987654321098765432
DISCORD_STAFF_USER_IDS=123456789012345678
DISCORD_SAORI_CHAT_CHANNEL_ID=123456789012345678
DISCORD_TICKETS_CATEGORY_ID=123456789012345678
DISCORD_TICKETS_SUPPORT_CHANNEL_ID=123456789012345678

# --- SPOTIFY MUSIC ENGINE ---
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# --- MINECRAFT SERVER ---
MC_SERVER_HOST=mc.example.com
MC_SERVER_PORT=25565
MC_SERVER_BEDROCK_PORT=25565
MC_WEB_URL=https://web.example.com/
MC_STORE_URL=https://web.example.com/store
MC_GUIDE_URL=https://web.example.com/guide

# --- PTERODACTYL API (Optional Console Automation) ---
PTERO_BASE_URL=https://panel.example.com/api/client/servers/your_server_id
PTERO_API_KEY=your_pterodactyl_client_api_key_here

# --- AI ENGINES & DAEMONS ---
AI_DAEMON_PORT=8089
AI_DAEMON_URL=http://127.0.0.1:8089/chat
TTS_URL=http://127.0.0.1:8089/tts
STT_URL=http://127.0.0.1:8089/stt
IMG_URL=http://127.0.0.1:8089/image
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CODEX_BIN_PATH=/path/to/codex

# --- WHATSAPP (Baileys) ---
WHATSAPP_AUTH_DIR=/opt/stacks/saori-unified/data/auth_info
WHATSAPP_ADMIN_PHONE=1234567890
WHATSAPP_NOTIFY_GROUP_JID=your_group_jid@g.us
