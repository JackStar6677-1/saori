# =============================================================================
# SAORI KOKORO â€” Open Autonomous Multi-Agent SRE Framework
# =============================================================================
# Copy this file to `.env` and fill in the values for your infrastructure.
# NEVER commit your real `.env` file to public repositories.

# -----------------------------------------------------------------------------
# 1. IDENTITY & KOKORO CORE (CANONICAL PERSONA)
# -----------------------------------------------------------------------------
SAORI_OWNER="Lead Engineer"
SAORI_SYSTEM="Autonomous Cloud Infrastructure"
SAORI_PRIMARY_PROVIDER=ollama   # Choices: ollama, anthropic, openai, gemini
# Optional custom system prompt (if omitted, Kokoro dynamically generates a compressed prompt)
# SAORI_SYSTEM_PROMPT="You are SAORI, an autonomous SRE orchestrator..."

# -----------------------------------------------------------------------------
# 2. MULTI-PROVIDER AI ADAPTERS (Configure at least ONE provider)
# -----------------------------------------------------------------------------

# --- A) Local Ollama (100% Free, Private, Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- B) Anthropic Claude ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# --- C) OpenAI Direct ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- D) OpenAI-Compatible Endpoints (vLLM, LocalAI, DeepSeek, OpenCode, Groq) ---
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_API_KEY=none
OPENAI_COMPATIBLE_MODEL=deepseek-r1

# --- E) Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# 3. NEURAL OBSERVATORY & PERSISTENT MEMORY
# -----------------------------------------------------------------------------
SAORI_DATA_DIR=./data
SAORI_OBSERVATORY_PORT=8089
SAORI_CLUSTER_LABEL="Distributed Mesh Â· Local Swarm Node Â· Ready"
# Optional external MCP / REST memory server (defaults to automatic local SQLite WAL)
# SAORI_MEMORY_URL=http://127.0.0.1:8077

# -----------------------------------------------------------------------------
# 4. DISCORD BOT INTEGRATION (Optional)
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=123456789012345678
DISCORD_OWNER_ID=123456789012345678
DISCORD_STAFF_ROLE_IDS=123456789012345678,987654321098765432
DISCORD_SAORI_CHAT_CHANNEL_ID=123456789012345678
DISCORD_TICKETS_CATEGORY_ID=123456789012345678
DISCORD_TICKETS_SUPPORT_CHANNEL_ID=123456789012345678

# -----------------------------------------------------------------------------
# 5. WHATSAPP BRIDGE (Baileys Engine - Optional)
# -----------------------------------------------------------------------------
AUTH_DIR=./data/auth_info
ADMIN_WHATSAPP_NUMBER=56900000000
ADMIN_PHONE_NUMBERS=56900000000
ADMIN_NAMES=admin,owner,lead
HIGH_STAFF_NAMES=admin,moderator,operator
WHATSAPP_STAFF_GROUP_JID=120363000000000000@g.us
SERVER_HOST_LABEL=SRE-Production-Cluster

# -----------------------------------------------------------------------------
# 6. GAME SERVER / MINECRAFT TELEMETRY (Optional)
# -----------------------------------------------------------------------------
MC_SERVER_DOMAIN=mc.example.com
MC_SERVER_HOST=mc.example.com
MC_SERVER_PORT=25565
MC_SERVER_BEDROCK_PORT=19132
