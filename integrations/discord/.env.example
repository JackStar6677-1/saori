# ==============================================================================
# SAORI DISCORD INTEGRATION — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Complete this template and rename it to .env before starting the bot.
# NEVER commit your actual .env file or Discord Bot Token to public repositories!
# ==============================================================================

# --- Discord Authentication ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
GUILD_ID=your_guild_id_here
OWNER_DISCORD_ID=your_discord_user_id_here

# --- Spotify Music Integration (Optional for /play Spotify URLs) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Core AI & Multi-Modal Microservices ---
AI_DAEMON_URL=http://127.0.0.1:8089/chat
IMAGE_DAEMON_URL=http://127.0.0.1:8089/image
TTS_URL=http://127.0.0.1:8089/tts
STT_URL=http://127.0.0.1:8089/stt

# --- Server Channel IDs ---
CHANNEL_BIENVENIDAS=
CHANNEL_TICKETS_SOPORTE=
CHANNEL_CATEGORIA_TICKETS=
CHANNEL_DENUNCIAS=
CHANNEL_GENERAL_ES=
CHANNEL_STAFF_CHAT=
CHANNEL_TAREAS_PENDIENTES=
CHANNEL_REGLAS=
CHANNEL_AUTO_ROLES=
CHANNEL_SUGERENCIAS=
CHANNEL_LINKS=
CHANNEL_SPAM=
CHANNEL_MUDAE=
CHANNEL_MEDIA=
CHANNEL_FORO_BUGS=
CHANNEL_AUDITORIA=
CHANNEL_SAORI_CHAT=

# --- Server Real-Time Statistics Channels ---
STATS_CATEGORY=
STATS_TOTAL_MEMBERS=
