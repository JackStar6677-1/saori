# =============================================================================
# SAORI WhatsApp Bridge - Environment Configuration
# =============================================================================

# Authentication directory for WhatsApp session keys (Baileys)
AUTH_DIR=./data/auth_info

# Administrator phone number (e.g. international format without '+')
ADMIN_WHATSAPP_NUMBER=56900000000
ADMIN_NAMES=jack,jackstar,owner

# High staff members recognized for command authorizations
HIGH_STAFF_NAMES=jack,chagui,pepino,lauti,lautaro,macgyver,kika,jessiel

# Staff group WhatsApp JID (e.g. 120363xxxxxxxxx@g.us)
WHATSAPP_STAFF_GROUP_JID=

# Public host display label for live telemetry / ping
SERVER_HOST_LABEL=Star VPS (Santiago/SRE)

# Pterodactyl Panel integration for live server metrics & console commands
PTERODACTYL_PANEL_URL=https://panel.thegamehosting.com
PTERODACTYL_SERVER_ID=
PTERODACTYL_API_KEY=

# Local microservices & AI endpoints
AI_DAEMON_URL=http://127.0.0.1:8089/chat
FAQ_DAEMON_URL=http://127.0.0.1:8089/faq
POWER_DAEMON_URL=http://127.0.0.1:8089/power
SPARK_DAEMON_URL=http://127.0.0.1:8089/spark
IMAGE_DAEMON_URL=http://127.0.0.1:8089/image
TTS_URL=http://127.0.0.1:8089/tts
STT_URL=http://127.0.0.1:8089/stt
WEBHOOK_PORT=8088
